<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#111111">

    <title>{{ page_title }}{% unless page_title contains shop.name %} - {{ shop.name }}{% endunless %}</title>
    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}
    <link rel="canonical" href="{{ canonical_url }}">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    {{ 'velora-base.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body class="velora-site">
    <a class="velora-skip-link" href="#MainContent">Skip to content</a>

    <header class="velora-header" id="SiteHeader">
      <div class="velora-announcement">
        <div class="velora-container velora-announcement__inner">
          <span>Premium wellness essentials for better sleep, recovery and everyday comfort</span>
        </div>
      </div>

      <div class="velora-header__main">
        <div class="velora-container velora-header__row">
          <button class="velora-mobile-toggle" type="button" aria-expanded="false" aria-controls="VeloraNav" id="VeloraMenuToggle">
            <span></span>
            <span></span>
            <span></span>
          </button>

          <a href="{{ routes.root_url }}" class="velora-logo" aria-label="{{ shop.name }} home">VELORA</a>

          <nav class="velora-nav" id="VeloraNav" aria-label="Main navigation">
            <a href="{{ routes.root_url }}" class="velora-nav__link">Home</a>
            <a href="{{ routes.collections_url }}" class="velora-nav__link">Shop</a>
            <a href="/collections/sleep" class="velora-nav__link">Sleep</a>
            <a href="/collections/recovery" class="velora-nav__link">Recovery</a>
            <a href="/collections/daily-comfort" class="velora-nav__link">Daily Comfort</a>
            <a href="/pages/about" class="velora-nav__link">About</a>
            <a href="/pages/faq" class="velora-nav__link">FAQ</a>
            <a href="/pages/contact" class="velora-nav__link">Contact</a>
          </nav>

          <div class="velora-header__actions">
            <a href="{{ routes.search_url }}" class="velora-header__icon" aria-label="Search">Search</a>
            <a href="{{ routes.cart_url }}" class="velora-cart-link" aria-label="Cart">
              Cart
              {%- if cart.item_count > 0 -%}
                <span class="velora-cart-count">{{ cart.item_count }}</span>
              {%- endif -%}
            </a>
          </div>
        </div>
      </div>
    </header>

    <main id="MainContent" class="velora-main" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    <footer class="velora-footer">
      <div class="velora-container">
        <div class="velora-footer__grid">
          <div class="velora-footer__brand">
            <a href="{{ routes.root_url }}" class="velora-logo velora-logo--footer">VELORA</a>
            <p>Thoughtfully selected essentials for better sleep, daily recovery and everyday comfort.</p>
          </div>

          <div>
            <h3 class="velora-footer__title">Shop</h3>
            <ul class="velora-footer__links">
              <li><a href="{{ routes.collections_url }}">All Products</a></li>
              <li><a href="/collections/sleep">Sleep</a></li>
              <li><a href="/collections/recovery">Recovery</a></li>
              <li><a href="/collections/daily-comfort">Daily Comfort</a></li>
            </ul>
          </div>

          <div>
            <h3 class="velora-footer__title">Support</h3>
            <ul class="velora-footer__links">
              <li><a href="/pages/about">About</a></li>
              <li><a href="/pages/faq">FAQ</a></li>
              <li><a href="/pages/contact">Contact</a></li>
              <li><a href="/policies/refund-policy">Returns</a></li>
            </ul>
          </div>

          <div>
            <h3 class="velora-footer__title">Legal</h3>
            <ul class="velora-footer__links">
              <li><a href="/policies/privacy-policy">Privacy Policy</a></li>
              <li><a href="/policies/terms-of-service">Terms of Service</a></li>
              <li><a href="/policies/shipping-policy">Shipping Policy</a></li>
            </ul>
          </div>
        </div>

        <div class="velora-footer__bottom">
          <span>&copy; {{ 'now' | date: '%Y' }} Velora</span>
          <span>Secure checkout - Clean design - Worldwide inspiration</span>
        </div>
      </div>
    </footer>

    <script>
      (function() {
        var toggle = document.getElementById('VeloraMenuToggle');
        var nav = document.getElementById('VeloraNav');
        if (!toggle || !nav) return;

        toggle.addEventListener('click', function() {
          var isOpen = nav.classList.toggle('is-open');
          toggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
        });
      })();
    </script>
  </body>
</html>
