<!-- =====================
     VELORA HOME PAGE
     sections/velora-home.liquid
     ===================== -->

<!-- 1. HERO -->
<section class="velora-hero">
  <div class="velora-container">
    <div class="velora-hero__content">
      <p class="velora-hero__eyebrow">Modern Wellness Essentials</p>
      <h1 class="velora-hero__title">Feel better,<br>every day.</h1>
      <p class="velora-hero__subtitle">Premium essentials for better sleep, daily recovery,<br class="hide-mobile"> and everyday comfort.</p>
      <div class="velora-hero__cta">
        <a href="{{ routes.collections_url }}" class="velora-btn velora-btn--dark">Shop Best Sellers</a>
        <a href="/collections/sleep" class="velora-btn velora-btn--ghost">Explore the Collection</a>
      </div>
    </div>
  </div>
</section>

<!-- 2. TRUST BAR -->
<section class="velora-trust-bar">
  <div class="velora-container">
    <div class="velora-trust-bar__grid">
      <div class="velora-trust-bar__item">
        <span class="velora-trust-bar__icon">&#10003;</span>
        <span>Thoughtfully selected products</span>
      </div>
      <div class="velora-trust-bar__item">
        <span class="velora-trust-bar__icon">&#128274;</span>
        <span>Secure checkout</span>
      </div>
      <div class="velora-trust-bar__item">
        <span class="velora-trust-bar__icon">&#127758;</span>
        <span>Worldwide shipping</span>
      </div>
      <div class="velora-trust-bar__item">
        <span class="velora-trust-bar__icon">&#8635;</span>
        <span>Easy returns</span>
      </div>
    </div>
  </div>
</section>

<!-- 3. CATEGORIES -->
<section class="velora-categories">
  <div class="velora-container">
    <div class="velora-section-header">
      <h2 class="velora-section-title">Wellness that fits real life</h2>
      <p class="velora-section-subtitle">Discover practical products designed to support better rest, easier recovery, and more everyday comfort.</p>
    </div>
    <div class="velora-categories__grid">
      <a href="/collections/sleep" class="velora-category-card">
        <span class="velora-category-card__icon">&#127769;</span>
        <h3 class="velora-category-card__title">Sleep</h3>
        <p class="velora-category-card__desc">Create a calmer, darker, more restful environment every night.</p>
        <span class="velora-category-card__link">Shop Sleep &rarr;</span>
      </a>
      <a href="/collections/recovery" class="velora-category-card">
        <span class="velora-category-card__icon">&#9889;</span>
        <h3 class="velora-category-card__title">Recovery</h3>
        <p class="velora-category-card__desc">Relieve tension, ease muscle fatigue and support daily recovery.</p>
        <span class="velora-category-card__link">Shop Recovery &rarr;</span>
      </a>
      <a href="/collections/daily-comfort" class="velora-category-card">
        <span class="velora-category-card__icon">&#9729;</span>
        <h3 class="velora-category-card__title">Daily Comfort</h3>
        <p class="velora-category-card__desc">Small upgrades that make your home and work routine feel better.</p>
        <span class="velora-category-card__link">Shop Daily Comfort &rarr;</span>
      </a>
    </div>
  </div>
</section>

<!-- 4. BEST SELLERS -->
<section class="velora-products">
  <div class="velora-container">
    <div class="velora-section-header">
      <h2 class="velora-section-title">Best Sellers</h2>
      <p class="velora-section-subtitle">Our most-loved essentials for calmer evenings, better rest, and more comfortable days.</p>
    </div>
    <div class="velora-products__grid">
      {%- assign featured = collections['frontpage'] | default: collections.all -%}
      {%- for product in featured.products limit: 8 -%}
        <div class="velora-product-card">
          <a href="{{ product.url }}" class="velora-product-card__image-wrap">
            {%- if product.featured_image -%}
              <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.featured_image.alt | escape }}" width="600" height="600" loading="lazy" class="velora-product-card__image">
            {%- else -%}
              <div class="velora-product-card__placeholder">&#9744;</div>
            {%- endif -%}
          </a>
          <div class="velora-product-card__info">
            <p class="velora-product-card__vendor">{{ product.vendor }}</p>
            <a href="{{ product.url }}" class="velora-product-card__title">{{ product.title }}</a>
            <p class="velora-product-card__price">
              {{ product.price | money }}
              {%- if product.compare_at_price > product.price -%}
                <span class="velora-product-card__compare">{{ product.compare_at_price | money }}</span>
              {%- endif -%}
            </p>
            <a href="{{ product.url }}" class="velora-btn velora-btn--dark velora-btn--sm">View Product</a>
          </div>
        </div>
      {%- else -%}
        <p class="velora-empty-state">Add products to your store to see them here.</p>
      {%- endfor -%}
    </div>
    <div class="velora-section-footer">
      <a href="{{ routes.collections_url }}" class="velora-btn velora-btn--ghost">View All Products</a>
    </div>
  </div>
</section>

<!-- 5. WHY VELORA -->
<section class="velora-why">
  <div class="velora-container">
    <div class="velora-section-header">
      <h2 class="velora-section-title">Why Velora</h2>
      <p class="velora-section-subtitle" style="max-width:620px;">We believe wellness should feel simple, practical, and easy to trust. That&rsquo;s why we focus on everyday products that support comfort, better routines, and a calmer lifestyle &mdash; without overcomplicating the experience.</p>
    </div>
    <div class="velora-why__grid">
      <div class="velora-why__item">
        <span class="velora-why__icon">&#10024;</span>
        <h3 class="velora-why__title">Curated with care</h3>
        <p class="velora-why__desc">We focus on practical products with clear everyday value, selected for quality and reliability.</p>
      </div>
      <div class="velora-why__item">
        <span class="velora-why__icon">&#128274;</span>
        <h3 class="velora-why__title">Clean, easy shopping</h3>
        <p class="velora-why__desc">A calm and intuitive experience from browsing to checkout, with no friction and no surprises.</p>
      </div>
      <div class="velora-why__item">
        <span class="velora-why__icon">&#9749;</span>
        <h3 class="velora-why__title">Designed for modern routines</h3>
        <p class="velora-why__desc">Products that fit naturally into daily life and genuinely improve the way you feel.</p>
      </div>
    </div>
  </div>
</section>

<!-- 6. REVIEWS -->
<section class="velora-reviews">
  <div class="velora-container">
    <div class="velora-section-header">
      <h2 class="velora-section-title">What our customers say</h2>
    </div>
    <div class="velora-reviews__grid">
      <div class="velora-review-card">
        <p class="velora-review-card__stars">&#9733;&#9733;&#9733;&#9733;&#9733;</p>
        <p class="velora-review-card__text">&ldquo;The sleep mask is genuinely the best I&rsquo;ve tried. Light, comfortable, and I actually wake up feeling rested.&rdquo;</p>
        <p class="velora-review-card__author">&mdash; Sarah M., verified buyer</p>
      </div>
      <div class="velora-review-card">
        <p class="velora-review-card__stars">&#9733;&#9733;&#9733;&#9733;&#9733;</p>
        <p class="velora-review-card__text">&ldquo;Fast shipping, well packaged and exactly what I expected. I&rsquo;ve already ordered a second product.&rdquo;</p>
        <p class="velora-review-card__author">&mdash; James T., verified buyer</p>
      </div>
      <div class="velora-review-card">
        <p class="velora-review-card__stars">&#9733;&#9733;&#9733;&#9733;&#9733;</p>
        <p class="velora-review-card__text">&ldquo;Love the simplicity of this brand. Clean design, good products, and a checkout that actually works.&rdquo;</p>
        <p class="velora-review-card__author">&mdash; Elena R., verified buyer</p>
      </div>
    </div>
  </div>
</section>

<!-- 7. FAQ -->
<section class="velora-faq-preview">
  <div class="velora-container">
    <div class="velora-section-header">
      <h2 class="velora-section-title">Frequently asked questions</h2>
    </div>
    <div class="velora-faq-preview__list">
      <details class="velora-faq-item">
        <summary class="velora-faq-item__q">How long does shipping take?</summary>
        <p class="velora-faq-item__a">Most orders arrive within 7&ndash;14 business days depending on your location. Estimated delivery times are shown at checkout.</p>
      </details>
      <details class="velora-faq-item">
        <summary class="velora-faq-item__q">Can I return my order?</summary>
        <p class="velora-faq-item__a">Yes. Please review our <a href="/policies/refund-policy">Returns &amp; Refunds Policy</a> for full details before placing your order.</p>
      </details>
      <details class="velora-faq-item">
        <summary class="velora-faq-item__q">How do I track my package?</summary>
        <p class="velora-faq-item__a">Once your order ships, you&rsquo;ll receive a confirmation email with tracking information included.</p>
      </details>
      <details class="velora-faq-item">
        <summary class="velora-faq-item__q">Are your products medical devices?</summary>
        <p class="velora-faq-item__a">Unless explicitly stated on the product page, our products are not medical devices and are not intended to diagnose, treat, cure, or prevent any disease.</p>
      </details>
    </div>
    <div class="velora-section-footer">
      <a href="/pages/faq" class="velora-btn velora-btn--ghost">View all FAQs</a>
    </div>
  </div>
</section>

<!-- 8. CLOSING CTA -->
<section class="velora-cta-banner">
  <div class="velora-container">
    <h2 class="velora-cta-banner__title">Build better routines,<br>one simple upgrade at a time.</h2>
    <a href="{{ routes.collections_url }}" class="velora-btn velora-btn--light">Shop Now</a>
  </div>
</section>

{% schema %}
{
  "name": "Velora Home",
  "tag": "section",
  "class": "velora-home",
  "settings": []
}
{% endschema %}
