{% section 'page-hero' %}
<section class="velora-page-content">
  <div class="velora-page-inner">
    <h1>Contact us</h1>
    <p>We are here to help with questions about orders, shipping, returns, or product details.</p>
    <a class="velora-contact-link" href="mailto:support@yourdomain.com">support@yourdomain.com</a>
  </div>
</section>

<style>
  .velora-page-content { padding: 72px 24px; background: #f7f5f1; color: #1f2321; }
  .velora-page-inner { max-width: 860px; margin: 0 auto; display: grid; gap: 16px; }
  .velora-page-inner h1 { font-size: 2.2rem; margin-bottom: 6px; }
  .velora-page-inner p { color: #4b544f; line-height: 1.8; }
  .velora-contact-link { display: inline-block; padding: 12px 18px; background: #3e4a42; color: #fff; border-radius: 999px; text-decoration: none; width: fit-content; }
</style>
